# 시그널 성과 추적 스케줄러(Step 7) 상시 구동용 systemd 유닛.
# 실행할 코드가 아직 없다 — Step 7 에서 구현한 뒤에 등록할 것.
[Unit]
Description=AI Trading Signal Result Tracker Scheduler
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/traders
ExecStart=/var/www/traders/trading_engine/venv/bin/python -m trading_engine.database.result_tracker_scheduler
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

{
    "name": "ai-trading/api",
    "description": "AI Trading Platform - PHP REST API (SaaS backend)",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^7.1",
        "predis/predis": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "scripts": {
        "serve": "php -S 127.0.0.1:8080 -t public public/index.php",
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "serve": "로컬 미리보기 서버 (http://127.0.0.1:8080)",
        "test": "PHPUnit 단위 테스트"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}

# 이 파일을 복사해서 .env로 사용하세요: cp .env.example .env
# .env는 절대 커밋하지 마세요 (.gitignore에 이미 포함됨)

APP_ENV=local
APP_MODE=PAPER

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ai_trading
DB_USERNAME=ai_trading
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Upbit API (조회/매매 권한만 부여, 출금 권한 절대 부여 금지, IP 화이트리스트 필수)
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=


# ccxt 로 수집할 거래소 (쉼표 구분, ccxt id).
# 미지정 시 기본값: binance,okx,bybit,coinbase,upbit
# 시세는 공개 엔드포인트라 거래소 API 키가 필요 없다 (업비트 매매 키는 Step 5).
EXCHANGES=

# 거래소 무관 심볼 (쉼표 구분, base 만). 미지정 시 기본값: BTC,ETH,XRP,SOL,DOGE
# 견적통화는 거래소마다 다르게 붙는다 (binance BTC/USDT, upbit BTC/KRW).
SYMBOLS=

# Redis 캐시 TTL(초). 엔진이 멈췄을 때 낡은 값이 살아있는 것처럼 보이지 않게 한다.
# ticker/orderbook은 초 단위로 갱신되고, 5분봉 캔들과 지표는 그보다 뜸하므로 따로 준다.
MARKET_CACHE_TTL_SEC=60
MARKET_CANDLE_TTL_SEC=3600
MARKET_INDICATOR_TTL_SEC=300

# OpenAI (호환 API)
# 카페24 LLM Router 를 쓰면 base_url 을 반드시 지정해야 한다. 비워두면 OpenAI 본사로
# 요청이 가서 sk-cafe24-... 키가 401 로 거부된다.
#   카페24: https://llm-router.cafe24.com/api/v1  (콘솔: https://llm-router.cafe24.com/docs)
#   OpenAI 직접 사용 시: 비워둔다
OPENAI_BASE_URL=https://llm-router.cafe24.com/api/v1
OPENAI_API_KEY=
# 신호 분석용 (Step 2). 계정에서 쓸 수 있는 모델명을 넣는다
OPENAI_MODEL=REPLACE_WITH_ACTUAL_MODEL_NAME
# 뉴스 감성 분류용 (Step 11). 헤드라인만 보므로 저렴한 모델로 충분하다.
# 미지정 시 OPENAI_MODEL 을 쓴다
OPENAI_NEWS_MODEL=

# --- AI 호출 예산 (Step 2, 2026-09-03) --------------------------------------
# 신호 하나마다 부르는 것이 아니라 룰 게이트(Tech 70↑/30↓ + 합의 50%↑)를 통과한 것만
# 부른다. 그래도 유저가 없는 동안 계속 나가므로 아래 모드로 한 번 더 조인다.
#   off  - 부르지 않는다. 룰 신호는 그대로 나온다 (로컬 개발·테스트)
#   seed - 심볼당 하루 N건만. 적중률 기록을 계속 쌓기 위한 최소량 (기본값)
#   full - 게이트를 통과한 신호 전부
# 실측 비용(gpt-5-mini 공개가, 5심볼): seed 약 $1.5/월, full 약 $19~37/월.
AI_MODE=seed
# seed 모드에서 심볼 하나에 허용할 하루 호출 수. 5 × 5심볼 = 25건/일.
# 카운터가 아니라 간격(24h ÷ N)으로 동작해 시간대에 고르게 퍼진다.
AI_SEED_CALLS_PER_SYMBOL=5
# 조회자 표시(`watch:{symbol}`)의 수명(초). 이 표시가 있는 심볼은 seed 모드에서도
# 제한 없이 호출한다. 표시는 Step 6 API / Step 9 대시보드가 남긴다.
AI_VIEWER_TTL_SEC=600

# 매크로 지표 (Step 11-b). https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 뉴스 수집 주기(초). 미지정 시 300
NEWS_POLL_SEC=

# PHP API
JWT_SECRET=change_me_to_a_long_random_string
APP_URL=http://localhost:8080
# 유저에게 발급하는 웹훅 URL 의 앞부분 (Step 3). 수신은 Python 엔진이 맡으므로
# PHP API 와 호스트/포트가 다를 수 있다. 비워두면 APP_URL 을 쓴다.
WEBHOOK_BASE_URL=
# --- 웹훅 수신 (Step 3-b) ---------------------------------------------------
# 엔진이 여는 유일한 포트. nginx 가 /webhook/tv/ 를 이 포트로 넘긴다.
# 외부에 직접 노출하지 말 것 - 반드시 127.0.0.1 에 바인딩한다.
WEBHOOK_ENABLED=1
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8100
# 토큰 하나가 분당 보낼 수 있는 요청 수
WEBHOOK_RATE_PER_MIN=60
# 수신 시각 기준 이 시간(분) 안의 같은 심볼 ai_signals 만 참고 연결한다
WEBHOOK_LINK_WINDOW_MIN=15
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60

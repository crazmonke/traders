# 이 파일을 복사해서 .env로 사용하세요: cp .env.example .env
# .env는 절대 커밋하지 마세요 (.gitignore에 이미 포함됨)

APP_ENV=local
APP_MODE=PAPER

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ai_trading
DB_USERNAME=ai_trading
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Upbit API (조회/매매 권한만 부여, 출금 권한 절대 부여 금지, IP 화이트리스트 필수)
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# 수집 대상 마켓 (쉼표 구분). 미지정 시 기본값:
# KRW-BTC,KRW-ETH,KRW-XRP,KRW-SOL,KRW-DOGE
# 코인을 늘리려면 이 줄만 수정하면 되고 코드 변경은 필요 없다.
MARKETS=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=REPLACE_WITH_ACTUAL_MODEL_NAME

# PHP API
JWT_SECRET=change_me_to_a_long_random_string
APP_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60

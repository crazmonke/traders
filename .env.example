# 이 파일을 복사해서 .env로 사용하세요: cp .env.example .env
# .env는 절대 커밋하지 마세요 (.gitignore에 이미 포함됨)

APP_ENV=local
APP_MODE=PAPER

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ai_trading
DB_USERNAME=ai_trading
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Upbit API (조회/매매 권한만 부여, 출금 권한 절대 부여 금지, IP 화이트리스트 필수)
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=


# ccxt 로 수집할 거래소 (쉼표 구분, ccxt id).
# 미지정 시 기본값: binance,okx,bybit,coinbase,upbit
# 시세는 공개 엔드포인트라 거래소 API 키가 필요 없다 (업비트 매매 키는 Step 5).
EXCHANGES=

# 거래소 무관 심볼 (쉼표 구분, base 만). 미지정 시 기본값: BTC,ETH,XRP,SOL,DOGE
# 견적통화는 거래소마다 다르게 붙는다 (binance BTC/USDT, upbit BTC/KRW).
SYMBOLS=

# Redis 캐시 TTL(초). 엔진이 멈췄을 때 낡은 값이 살아있는 것처럼 보이지 않게 한다.
# ticker/orderbook은 초 단위로 갱신되고, 5분봉 캔들과 지표는 그보다 뜸하므로 따로 준다.
MARKET_CACHE_TTL_SEC=60
MARKET_CANDLE_TTL_SEC=3600
MARKET_INDICATOR_TTL_SEC=300

# OpenAI
OPENAI_API_KEY=
# 신호 분석용 (Step 2). 계정에서 쓸 수 있는 모델명을 넣는다
OPENAI_MODEL=REPLACE_WITH_ACTUAL_MODEL_NAME
# 뉴스 감성 분류용 (Step 11). 헤드라인만 보므로 저렴한 모델로 충분하다.
# 미지정 시 OPENAI_MODEL 을 쓴다
OPENAI_NEWS_MODEL=

# 매크로 지표 (Step 11-b). https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 뉴스 수집 주기(초). 미지정 시 300
NEWS_POLL_SEC=

# PHP API
JWT_SECRET=change_me_to_a_long_random_string
APP_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
